# Main — single-pass parser so value-taking flags (--path, -s/--skill) consume
# their argument and never swallow a following flag.
main() {
    local command=""
    local command_args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -g|--global) GLOBAL_FLAG=true; shift ;;   # shorthand for --scope user
            --scope)
                if [[ -z "${2:-}" ]]; then echo -e "${RED}Error: --scope requires 'user' or 'project'${NC}"; exit 1; fi
                case "$2" in
                    user)    GLOBAL_FLAG=true ;;
                    project) GLOBAL_FLAG=false ;;
                    *) echo -e "${RED}Error: invalid scope '$2' (use 'user' or 'project')${NC}"; exit 1 ;;
                esac
                shift 2 ;;
            --check)     CHECK_ONLY=true; shift ;;
            -y|--yes)    YES_FLAG=true; shift ;;
            --all)       ALL_FLAG=true; shift ;;
            --force)     FORCE_FLAG=true; shift ;;
            --path)
                if [[ -z "${2:-}" ]]; then echo -e "${RED}Error: --path requires a directory${NC}"; exit 1; fi
                CUSTOM_PATH="$2"; shift 2 ;;
            -s|--skill)
                if [[ -z "${2:-}" ]]; then echo -e "${RED}Error: --skill requires a name${NC}"; exit 1; fi
                SPECIFIC_SKILL="$2"; shift 2 ;;
            --bundle)
                if [[ -z "${2:-}" ]]; then echo -e "${RED}Error: --bundle requires a file${NC}"; exit 1; fi
                BUNDLE_FILE="$2"; shift 2 ;;
            --key)
                if [[ -z "${2:-}" ]]; then echo -e "${RED}Error: --key requires a public key file${NC}"; exit 1; fi
                TRUST_KEY="$2"; shift 2 ;;
            -h|--help)
                command="${command:-help}"; shift ;;
            -v|--version)
                echo "skilla $SKILLA_VERSION"; exit 0 ;;
            -*)
                echo -e "${RED}Unknown flag: $1${NC}"; show_usage; exit 1 ;;
            *)
                if [[ -z "$command" ]]; then command="$1"; else command_args+=("$1"); fi
                shift ;;
        esac
    done

    if [[ -z "$command" ]]; then
        show_usage
        exit 1
    fi

    case "$command" in
        add|install)
            if [[ ${#command_args[@]} -lt 1 ]]; then
                echo -e "${RED}Error: add command requires a source URL${NC}"
                show_usage
                exit 1
            fi
            add_skill "${command_args[0]}"
            ;;
        update)
            update_skill "${command_args[0]:-}"
            ;;
        list|ls)
            list_skills
            ;;
        info)
            if [[ ${#command_args[@]} -lt 1 ]]; then
                echo -e "${RED}Error: info command requires a skill name${NC}"
                show_usage
                exit 1
            fi
            show_skill_info "${command_args[0]}"
            ;;
        remove|rm)
            remove_skill "${command_args[0]:-}"
            ;;
        plugin|plugins)
            cmd_plugin "${command_args[@]}"
            ;;
        repo)
            case "${command_args[0]:-}" in
                ls|list)
                    cmd_repo_ls "${command_args[1]:-}"
                    ;;
                *)
                    echo -e "${RED}Unknown repo subcommand: ${command_args[0]:-<none>} (try: repo ls <source>)${NC}"
                    exit 1
                    ;;
            esac
            ;;
        help)
            show_usage
            ;;
        version)
            echo "skilla $SKILLA_VERSION"
            ;;
        verify)
            if [[ ${#command_args[@]} -lt 1 ]]; then
                echo -e "${RED}Error: verify requires an artifact (e.g. a release .tgz)${NC}"
                show_usage
                exit 1
            fi
            verify_artifact "${command_args[0]}"
            ;;
        *)
            echo -e "${RED}Unknown command: $command${NC}"
            echo ""
            show_usage
            exit 1
            ;;
    esac
}

# Check for jq dependency
if ! command -v jq &> /dev/null; then
    echo -e "${RED}Error: jq is required but not installed${NC}"
    echo "Install jq: sudo apt-get install jq (Debian/Ubuntu)"
    echo "           brew install jq (macOS)"
    exit 1
fi

# Run main function
main "$@"
