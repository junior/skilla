#!/bin/bash

# skilla
# A script to manage Agent Skills and Agent Plugins from git repositories
# Skills:  https://agentskills.io/specification
# Plugins: https://agent-plugins.org/specification (Agent Plugins 1.0.0)

set -e

SKILLA_VERSION="0.4.0"

# Agent Plugins: the only spec version this client supports. Per the conformance
# rules the manifest rules are selected locally from `$schema` — the schema is
# never fetched at load time.
AGENT_PLUGINS_VERSION="1.0.0"
PLUGIN_SCHEMA_URL="https://agent-plugins.org/schemas/1.0.0/plugin.schema.json"
MCP_SCHEMA_URL="https://agent-plugins.org/schemas/1.0.0/mcp.schema.json"

# Default configuration
GLOBAL_SKILLS_DIR="$HOME/.agents/skills"
GLOBAL_REGISTRY="$HOME/.agents/registry.json"
PROJECT_SKILLS_DIR=".agents/skills"
PROJECT_REGISTRY=".agents/registry.json"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Global variables (flags are parsed inline in main())
GLOBAL_FLAG=false
CUSTOM_PATH=""
CHECK_ONLY=false
YES_FLAG=false
ALL_FLAG=false
FORCE_FLAG=false
SPECIFIC_SKILL=""
BUNDLE_FILE=""
TRUST_KEY=""

# Get skills directory
get_skills_dir() {
    if [[ -n "$CUSTOM_PATH" ]]; then
        echo "$CUSTOM_PATH"
    elif [[ "$GLOBAL_FLAG" == true ]]; then
        echo "$GLOBAL_SKILLS_DIR"
    else
        echo "$PROJECT_SKILLS_DIR"
    fi
}

# Get registry file
get_registry_file() {
    if [[ -n "$CUSTOM_PATH" ]]; then
        local registry_dir
        registry_dir=$(dirname "$CUSTOM_PATH")
        echo "$registry_dir/registry.json"
    elif [[ "$GLOBAL_FLAG" == true ]]; then
        echo "$GLOBAL_REGISTRY"
    else
        echo "$PROJECT_REGISTRY"
    fi
}

# --- Agent Plugins locations -------------------------------------------------
# An installed plugin keeps its package tree intact (so ${PLUGIN_ROOT} in its
# mcp.json stays meaningful) under <agents-dir>/plugins/<name>/, and gets a
# persistent <agents-dir>/plugin-data/<name>/ that survives updates.

# The directory holding .agents/ for the current scope (parent of the registry).
get_agents_dir() {
    local registry_file
    registry_file=$(get_registry_file)
    dirname "$registry_file"
}

get_plugins_dir() {
    echo "$(get_agents_dir)/plugins"
}

get_plugin_registry_file() {
    echo "$(get_agents_dir)/plugins.json"
}

# Absolute, symlink-resolved path — the spec requires PLUGIN_ROOT and PLUGIN_DATA
# to be absolute, and the project scope's paths are relative to the cwd.
_abspath() {
    local p="$1" d b
    if [[ -d "$p" ]]; then (cd "$p" && pwd -P); return 0; fi
    d=$(dirname "$p"); b=$(basename "$p")
    if [[ -d "$d" ]]; then
        echo "$(cd "$d" && pwd -P)/$b"
    else
        case "$p" in
            /*) echo "$p" ;;
            *)  echo "$PWD/${p#./}" ;;
        esac
    fi
}

plugin_root_for() {
    _abspath "$(get_plugins_dir)/$1"
}

plugin_data_for() {
    _abspath "$(get_agents_dir)/plugin-data/$1"
}

# Initialize skills system
init_skills_system() {
    local skills_dir
    skills_dir=$(get_skills_dir)
    local registry_file
    registry_file=$(get_registry_file)

    mkdir -p "$skills_dir"

    local registry_dir
    registry_dir=$(dirname "$registry_file")
    mkdir -p "$registry_dir"

    if [[ ! -f "$registry_file" ]]; then
        echo '{}' > "$registry_file"
    fi
}

# Extract repo name from URL
extract_repo_name() {
    local url="$1"
    local basename

    if [[ $url =~ ^git@([^:]+):(.+)$ ]]; then
        basename=$(basename "${BASH_REMATCH[2]}" .git)
    elif [[ $url =~ ^https?://([^/]+)/(.+)$ ]]; then
        basename=$(basename "${BASH_REMATCH[2]}" .git)
    elif [[ $url =~ ^([^/]+)/(.+)$ ]]; then
        basename="${BASH_REMATCH[2]}"
    else
        basename=$(basename "$url" .git)
    fi

    echo "$basename"
}

# Clone $1 into $2. With a probe path ($3) and sparse patterns ($4...), attempt a
# PARTIAL + SPARSE clone (--filter=blob:none --sparse) so only the requested
# skill's files are downloaded — big catalogs (microsoft/azure-skills,
# nvidia/skills) don't cost a full checkout. Falls back to a plain shallow clone
# when the git/transport lacks support (old git, plain local paths, servers
# without filter support) or when the probe path is absent after the sparse
# checkout (unexpected repo layout, e.g. a single root-SKILL.md repo).
clone_source() {
    local source="$1" dest="$2" probe="${3:-}"
    shift 2
    if [[ $# -gt 0 ]]; then shift; fi     # drop the probe; the rest are patterns
    if [[ $# -gt 0 ]]; then
        if git clone --depth 1 --filter=blob:none --sparse "$source" "$dest" 2>/dev/null \
            && git -C "$dest" sparse-checkout set --no-cone "$@" 2>/dev/null \
            && { [[ -z "$probe" ]] || [[ -e "$dest/$probe" ]]; }; then
            return 0
        fi
        rm -rf "$dest"
        mkdir -p "$dest"
    fi
    git clone --depth 1 "$source" "$dest" 2>/dev/null
}

# Get git commit (use -C so we never change the caller's working directory)
get_git_commit() {
    local repo_path="$1"
    git -C "$repo_path" rev-parse HEAD 2>/dev/null || echo "unknown"
}

# Portable UTC timestamp (GNU `date -Iseconds` is not available on BSD/macOS).
_now() {
    date -u +%Y-%m-%dT%H:%M:%SZ
}

# Get remote commit
get_remote_commit() {
    local url="$1"
    local commit_hash
    commit_hash=$(git ls-remote "$url" HEAD 2>/dev/null | awk '{print $1}')

    if [[ -z "$commit_hash" ]]; then
        echo "unknown"
    else
        echo "$commit_hash"
    fi
}

# Read one key out of the SKILL.md `metadata:` block. agentskills.io defines
# `metadata` as a map of string keys to string values and it is where non-spec
# properties (notably `version`) belong — there is no top-level `version:` field.
extract_metadata_field() {
    local skill_path="$1" key="$2"
    local skill_file="$skill_path/SKILL.md"
    [[ -f "$skill_file" ]] || return 0
    sed -n '/^---$/,/^---$/p' "$skill_file" | awk -v key="$key" '
        /^metadata:[[:space:]]*$/ { inblock=1; next }
        inblock && /^[^[:space:]#]/ { inblock=0 }
        inblock {
            if (match($0, "^[[:space:]]+" key ":[[:space:]]*")) {
                v = substr($0, RSTART + RLENGTH)
                sub(/[[:space:]]+$/, "", v)
                gsub(/^["'"'"']|["'"'"']$/, "", v)
                if (v != "") { print v; exit }
            }
        }
    '
}

# Extract version, spec-preferred order:
#   1. SKILL.md `metadata.version`  (agentskills.io: the conformant location)
#   2. SKILL.md top-level `version:` (legacy; not a spec field, still in the wild)
#   3. plugin.json `.version`        (Agent Plugins manifest, when the skill ships in one)
extract_skill_version() {
    local skill_path="$1"
    local skill_file="$skill_path/SKILL.md"
    local version=""

    if [[ -f "$skill_file" ]]; then
        version=$(extract_metadata_field "$skill_path" "version")
        if [[ -z "$version" ]]; then
            version=$(sed -n '/^---$/,/^---$/p' "$skill_file" \
                | grep -E '^[[:space:]]*version:' | head -1 \
                | sed -E 's/^[[:space:]]*version:[[:space:]]*//' | tr -d '"'"'"' ')
        fi
    fi
    if [[ -z "$version" && -f "$skill_path/plugin.json" ]]; then
        version=$(jq -r '.version // empty' "$skill_path/plugin.json" 2>/dev/null)
    fi
    echo "$version"
}

# Extract a skill's dependencies. `requires` is a skilla extension, not an
# agentskills.io field, so it is read from three places in order: the spec-safe
# `metadata.requires` string ("a, b"), a top-level `requires` list, then
# plugin.json `requiredSkills`. Prints one skill name per line.
get_skill_requires() {
    local skill_dir="$1"
    local skill_file="$skill_dir/SKILL.md"
    local reqs=""

    reqs=$(extract_metadata_field "$skill_dir" "requires" | tr ',' ' ' | tr ' ' '\n' | grep -v '^$' || true)

    if [[ -z "$reqs" && -f "$skill_file" ]]; then
        reqs=$(sed -n '/^---$/,/^---$/p' "$skill_file" | awk '
            /^requires:[[:space:]]*\[/ {
                line=$0; sub(/^requires:[[:space:]]*\[/,"",line); sub(/\].*$/,"",line);
                gsub(/[",]/," ",line); n=split(line,a," ");
                for (i=1;i<=n;i++) if (a[i]!="") print a[i];
                next
            }
            /^requires:[[:space:]]*$/ { inlist=1; next }
            inlist && /^[[:space:]]*-[[:space:]]*/ {
                v=$0; sub(/^[[:space:]]*-[[:space:]]*/,"",v); gsub(/[[:space:]"]/,"",v);
                if (v!="") print v; next
            }
            inlist && /^[^[:space:]-]/ { inlist=0 }
        ')
    fi
    if [[ -z "$reqs" && -f "$skill_dir/plugin.json" ]]; then
        # `extensions["dev.skilla"]` is the Agent Plugins-conformant home for
        # this; a bare top-level `requiredSkills` is the pre-1.0.0 form.
        reqs=$(jq -r '(.extensions["dev.skilla"].requiredSkills? // .requiredSkills? // [])[]? // empty' \
            "$skill_dir/plugin.json" 2>/dev/null)
    fi
    echo "$reqs"
}

# Read one frontmatter field (single-line value) from a skill dir's SKILL.md.
extract_frontmatter_field() {
    local skill_path="$1" field="$2"
    local skill_file="$skill_path/SKILL.md"
    [[ -f "$skill_file" ]] || return 0
    sed -n '/^---$/,/^---$/p' "$skill_file" \
        | grep -E "^[[:space:]]*$field:" | head -1 \
        | sed -E "s/^[[:space:]]*$field:[[:space:]]*//" | tr -d '"'
}

# List the skills available in a repository — no install, nothing persisted.
# Uses a partial+sparse clone (SKILL.md files only) when the server supports it.
cmd_repo_ls() {
    local source="$1"
    if [[ -z "$source" ]]; then
        echo -e "${RED}Error: repo ls requires a source URL${NC}"
        show_usage
        exit 1
    fi

    local temp_dir
    temp_dir=$(mktemp -d)
    echo -e "${BLUE}Skills in: $source${NC}"
    if ! clone_source "$source" "$temp_dir" "" "/skills/*/SKILL.md" "/SKILL.md"; then
        echo -e "${RED}Failed to clone repository${NC}"
        rm -rf "$temp_dir"
        return 1
    fi

    local dirs=() d
    if [[ -d "$temp_dir/skills" ]]; then
        for d in "$temp_dir"/skills/*/; do
            [[ -f "${d}SKILL.md" ]] && dirs+=("$d")
        done
    fi
    if [[ ${#dirs[@]} -eq 0 && -f "$temp_dir/SKILL.md" ]]; then
        dirs=("$temp_dir")
    fi
    if [[ ${#dirs[@]} -eq 0 ]]; then
        echo -e "${RED}No skills found (no skills/*/SKILL.md and no root SKILL.md)${NC}"
        rm -rf "$temp_dir"
        return 1
    fi

    echo ""
    printf "%-30s %-10s %s\n" "NAME" "VERSION" "DESCRIPTION"
    printf "%-30s %-10s %s\n" "----" "-------" "-----------"
    local name ver desc
    for d in "${dirs[@]}"; do
        name=$(extract_frontmatter_field "$d" "name")
        if [[ -z "$name" ]]; then
            if [[ "$d" == "$temp_dir" ]]; then name=$(extract_repo_name "$source"); else name=$(basename "$d"); fi
        fi
        ver=$(extract_skill_version "$d")
        [[ -z "$ver" ]] && ver="-"
        desc=$(extract_frontmatter_field "$d" "description")
        if [[ ${#desc} -gt 76 ]]; then desc="${desc:0:73}..."; fi
        printf "%-30s %-10s %s\n" "$name" "$ver" "$desc"
    done
    echo ""
    echo "${#dirs[@]} skill(s) — install one with: skilla add $source --skill <name>"
    rm -rf "$temp_dir"
}

# Read registry
read_registry() {
    local registry_file
    registry_file=$(get_registry_file)

    if [[ -f "$registry_file" ]]; then
        cat "$registry_file"
    else
        echo '{}'
    fi
}

# Write registry
write_registry() {
    local registry_file
    registry_file=$(get_registry_file)
    local content="$1"
    echo "$content" > "$registry_file"
}

# Get skill info
get_skill_info() {
    local skill_name="$1"
    local registry
    registry=$(read_registry)

    echo "$registry" | jq -r --arg name "$skill_name" '.[$name] // empty'
}

# Save skill info
save_skill_info() {
    local skill_name="$1"
    local skill_info="$2"
    local registry
    registry=$(read_registry)

    registry=$(echo "$registry" | jq --arg name "$skill_name" --argjson info "$skill_info" '.[$name] = $info')
    write_registry "$registry"
}

# Remove skill from registry
remove_skill_from_registry() {
    local skill_name="$1"
    local registry
    registry=$(read_registry)

    registry=$(echo "$registry" | jq --arg name "$skill_name" 'del(.[$name])')
    write_registry "$registry"
}

# Check if skill is installed
is_skill_installed() {
    local skill_name="$1"
    local skill_info
    skill_info=$(get_skill_info "$skill_name")

    if [[ -n "$skill_info" ]] && [[ "$skill_info" != "null" ]]; then
        return 0
    else
        return 1
    fi
}

# Add skill(s) from a git source, resolving dependencies (`requires`) declared in
# the same source. CHECK_ONLY reports per-skill without installing.
add_skill() {
    local source="$1"

    init_skills_system

    local repo_name
    repo_name=$(extract_repo_name "$source")

    echo -e "${BLUE}Adding skill(s) from: $source${NC}"

    local temp_dir
    temp_dir=$(mktemp -d)

    echo "Cloning repository..."
    local clone_ok=0
    if [[ -n "$SPECIFIC_SKILL" ]]; then
        # Fetch only the requested skill (+ root metadata); dependency dirs are
        # sparse-added on demand while walking `requires`.
        clone_source "$source" "$temp_dir" "skills/$SPECIFIC_SKILL/SKILL.md" \
            "/skills/$SPECIFIC_SKILL/" "/SKILL.md" "/plugin.json" || clone_ok=1
    else
        clone_source "$source" "$temp_dir" || clone_ok=1
    fi
    if [[ $clone_ok -ne 0 ]]; then
        echo -e "${RED}Failed to clone repository${NC}"
        rm -rf "$temp_dir"
        return 1
    fi

    # An Agent Plugins package puts its skills at the same skills/<name>/SKILL.md
    # location, so installing them here is correct — but the package's manifest,
    # MCP config and extension dirs are dropped. Say so, and validate the parts
    # that affect the skills we are about to copy.
    if [[ -f "$temp_dir/plugin.json" ]] && is_agent_plugin "$temp_dir"; then
        local pname pver
        pname=$(plugin_field "$temp_dir" name)
        pver=$(plugin_field "$temp_dir" version)
        echo -e "${BLUE}Source is an Agent Plugin: ${pname} ${pver:+($pver) }[Agent Plugins $AGENT_PLUGINS_VERSION]${NC}"
        _v_reset
        if ! validate_plugin_manifest "$temp_dir"; then
            echo -e "${RED}plugin.json is fatally invalid — refusing to install from a rejected plugin${NC}"
            echo "Run 'skilla plugin validate' on the source to see the details."
            rm -rf "$temp_dir"
            return 1
        fi
        echo -e "${YELLOW}Installing its skills only — 'skilla plugin add $source' installs the whole package${NC}"
    fi

    local skills_root="$temp_dir/skills"
    local single_skill=false
    if [[ ! -d "$skills_root" ]]; then
        if [[ -f "$temp_dir/SKILL.md" ]]; then
            skills_root="$temp_dir"
            single_skill=true
        else
            echo -e "${RED}No 'skills/' directory and no root SKILL.md in repository${NC}"
            rm -rf "$temp_dir"
            return 1
        fi
    fi

    # Explicitly-requested skills.
    local requested=()
    if [[ "$single_skill" == true ]]; then
        requested=("$repo_name")
    elif [[ -n "$SPECIFIC_SKILL" ]]; then
        if [[ -f "$skills_root/$SPECIFIC_SKILL/SKILL.md" ]]; then
            requested=("$SPECIFIC_SKILL")
        else
            echo -e "${RED}Skill '$SPECIFIC_SKILL' not found in repository${NC}"
            rm -rf "$temp_dir"
            return 1
        fi
    else
        local sd
        for sd in "$skills_root"/*/; do
            if [[ -f "${sd}SKILL.md" ]]; then
                requested+=("$(basename "$sd")")
            fi
        done
    fi

    if [[ ${#requested[@]} -eq 0 ]]; then
        echo -e "${RED}No valid skills found in repository${NC}"
        rm -rf "$temp_dir"
        return 1
    fi

    # Expand with dependencies declared in the same source (transitive closure).
    local to_install=("${requested[@]}")
    local queue=("${requested[@]}")
    while [[ ${#queue[@]} -gt 0 ]]; do
        local cur="${queue[0]}"
        queue=("${queue[@]:1}")
        local cur_src
        if [[ "$single_skill" == true ]]; then cur_src="$skills_root"; else cur_src="$skills_root/$cur"; fi
        local dep
        # shellcheck disable=SC2046  # intentional word-split of dependency names
        for dep in $(get_skill_requires "$cur_src"); do
            # Sparse clones fetch skill dirs lazily — materialize the dependency
            # BEFORE deciding whether this source provides it.
            if [[ "$single_skill" != true && ! -f "$skills_root/$dep/SKILL.md" ]]; then
                git -C "$temp_dir" sparse-checkout add "/skills/$dep/" 2>/dev/null || true
            fi
            if [[ -f "$skills_root/$dep/SKILL.md" ]]; then
                local seen=false x
                for x in "${to_install[@]}"; do
                    if [[ "$x" == "$dep" ]]; then seen=true; break; fi
                done
                if [[ "$seen" == false ]]; then
                    echo -e "${BLUE}+ dependency: $dep (required by $cur)${NC}"
                    to_install+=("$dep")
                    queue+=("$dep")
                fi
            else
                echo -e "${YELLOW}! '$cur' requires '$dep', not in this source — install it separately${NC}"
            fi
        done
    done

    echo "Installing ${#to_install[@]} skill(s): ${to_install[*]}"

    local remote_commit commit_hash skills_dir
    remote_commit=$(get_remote_commit "$source")
    commit_hash=$(get_git_commit "$temp_dir")
    skills_dir=$(get_skills_dir)

    local skill_name
    for skill_name in "${to_install[@]}"; do
        echo ""
        echo -e "${BLUE}Processing: $skill_name${NC}"

        if is_skill_installed "$skill_name" && [[ "$FORCE_FLAG" != true ]]; then
            local cur_commit
            cur_commit=$(get_skill_info "$skill_name" | jq -r '.commit')
            if [[ "$CHECK_ONLY" == true ]]; then
                if [[ "$cur_commit" != "$commit_hash" && "$commit_hash" != "unknown" ]]; then
                    echo -e "${YELLOW}update available ($cur_commit -> $commit_hash)${NC}"
                else
                    echo -e "${GREEN}already up to date${NC}"
                fi
            else
                echo -e "${YELLOW}already installed — use 'update', or 'add --force' to reinstall${NC}"
            fi
            continue
        fi

        if [[ "$CHECK_ONLY" == true ]]; then
            echo -e "${GREEN}not installed (would install)${NC}"
            continue
        fi

        local src_dir dest_dir
        if [[ "$single_skill" == true ]]; then src_dir="$skills_root"; else src_dir="$skills_root/$skill_name"; fi
        dest_dir="$skills_dir/$skill_name"
        if [[ -d "$dest_dir" ]]; then rm -rf "$dest_dir"; fi
        cp -r "$src_dir" "$dest_dir"

        local version display_version skill_info
        version=$(extract_skill_version "$dest_dir")
        display_version="${version:-${commit_hash:0:10}}"
        skill_info=$(jq -n \
            --arg name "$skill_name" --arg source "$source" \
            --arg commit "$commit_hash" --arg remote_commit "$remote_commit" \
            --arg version "$version" --arg installed_at "$(_now)" \
            '{name:$name, source:$source, commit:$commit, remote_commit:$remote_commit,
              version:$version, installed_at:$installed_at, updated_at:$installed_at}')
        save_skill_info "$skill_name" "$skill_info"

        echo -e "${GREEN}installed '$skill_name' ($display_version)${NC} -> $dest_dir"
    done

    rm -rf "$temp_dir"
}

# Update skill
update_skill() {
    local skill_name="$1"

    init_skills_system

    if [[ -z "$skill_name" ]]; then
        echo -e "${BLUE}Updating all skills...${NC}"

        local registry
        registry=$(read_registry)

        local skill_names
        skill_names=$(echo "$registry" | jq -r 'keys[]')

        if [[ -z "$skill_names" ]]; then
            echo "No skills installed."
            return 0
        fi

        # shellcheck disable=SC2086  # intentional word-split of newline-separated keys
        for name in $skill_names; do
            update_single_skill "$name"
        done
    else
        update_single_skill "$skill_name"
    fi
}

update_single_skill() {
    local skill_name="$1"

    echo -e "${BLUE}Updating skill: $skill_name${NC}"

    if ! is_skill_installed "$skill_name"; then
        echo -e "${RED}Skill '$skill_name' is not installed${NC}"
        return 1
    fi

    local skill_info
    skill_info=$(get_skill_info "$skill_name")

    local source
    source=$(echo "$skill_info" | jq -r '.source')

    local temp_dir
    temp_dir=$(mktemp -d)

    echo "Fetching repository..."
    if ! clone_source "$source" "$temp_dir" "skills/$skill_name/SKILL.md" \
            "/skills/$skill_name/" "/SKILL.md"; then
        echo -e "${RED}Failed to clone repository${NC}"
        rm -rf "$temp_dir"
        return 1
    fi

    local remote_commit
    remote_commit=$(get_git_commit "$temp_dir")

    local current_commit
    current_commit=$(echo "$skill_info" | jq -r '.commit')

    if [[ "$CHECK_ONLY" == true ]]; then
        if [[ "$current_commit" != "$remote_commit" ]]; then
            echo -e "${YELLOW}Update available for '$skill_name'${NC}"
            echo "Current commit: $current_commit"
            echo "Remote commit: $remote_commit"
        else
            echo -e "${GREEN}Skill '$skill_name' is already up to date${NC}"
            echo "Commit: $current_commit"
        fi
        rm -rf "$temp_dir"
        return 0
    fi

    if [[ "$current_commit" == "$remote_commit" ]]; then
        echo -e "${GREEN}Skill '$skill_name' is already up to date${NC}"
        echo "Commit: $current_commit"
        rm -rf "$temp_dir"
        return 0
    else
        echo "Current commit: $current_commit"
        echo "Remote commit: $remote_commit"
        echo "Update available."
    fi

    # Resolve the skill's directory in the repo (skills/<name>/ or a root SKILL.md).
    local skill_source_dir
    if [[ -d "$temp_dir/skills/$skill_name" ]]; then
        skill_source_dir="$temp_dir/skills/$skill_name"
    elif [[ -f "$temp_dir/SKILL.md" ]]; then
        skill_source_dir="$temp_dir"
    else
        echo -e "${RED}Could not find skill '$skill_name' in repository${NC}"
        rm -rf "$temp_dir"
        return 1
    fi

    local skills_dir
    skills_dir=$(get_skills_dir)
    local skill_dest_dir="$skills_dir/$skill_name"

    echo "Updating skill..."
    rm -rf "$skill_dest_dir"
    cp -r "$skill_source_dir" "$skill_dest_dir"

    local version
    version=$(extract_skill_version "$skill_dest_dir")

    local updated_info
    updated_info=$(echo "$skill_info" | jq \
        --arg commit "$remote_commit" \
        --arg remote_commit "$remote_commit" \
        --arg version "$version" \
        --arg updated_at "$(_now)" \
        '.commit = $commit | .remote_commit = $remote_commit | .version = $version | .updated_at = $updated_at')

    save_skill_info "$skill_name" "$updated_info"

    local display_version
    if [[ -n "$version" ]]; then
        display_version="$version"
    else
        display_version="${remote_commit:0:10}"
    fi

    echo -e "${GREEN}Skill '$skill_name' updated successfully${NC}"
    echo "New version: $display_version"

    rm -rf "$temp_dir"
}

# List skills
list_skills() {
    init_skills_system

    local scope_text="project"
    if [[ -n "$CUSTOM_PATH" ]]; then
        scope_text="custom path"
    elif [[ "$GLOBAL_FLAG" == true ]]; then
        scope_text="user"
    fi

    echo -e "${BLUE}Installed skills ($scope_text):${NC}"
    echo ""

    local registry
    registry=$(read_registry)

    local skill_count
    skill_count=$(echo "$registry" | jq 'length')

    if [[ "$skill_count" -eq 0 ]]; then
        echo "No skills installed."
        return 0
    fi

    printf "%-30s %-15s %-40s %-20s\n" "NAME" "VERSION" "SOURCE" "UPDATED"
    printf "%-30s %-15s %-40s %-20s\n" "----" "-------" "------" "-------"

    echo "$registry" | jq -r 'to_entries[] | @json' | while IFS= read -r line; do
        local name version source updated_at

        name=$(echo "$line" | jq -r '.key')
        version=$(echo "$line" | jq -r '.value.version')
        source=$(echo "$line" | jq -r '.value.source')
        updated_at=$(echo "$line" | jq -r '.value.updated_at')

        if [[ -z "$version" ]] || [[ "$version" == "null" ]]; then
            local commit
            commit=$(echo "$line" | jq -r '.value.commit')
            version="${commit:0:10}"
        fi

        if [[ ${#source} -gt 37 ]]; then
            source="${source:0:37}..."
        fi

        printf "%-30s %-15s %-40s %-20s\n" "$name" "$version" "$source" "$updated_at"
    done
}

# Show skill info
show_skill_info() {
    local skill_name="$1"

    init_skills_system

    if ! is_skill_installed "$skill_name"; then
        echo -e "${RED}Skill '$skill_name' is not installed${NC}"
        return 1
    fi

    local skill_info
    skill_info=$(get_skill_info "$skill_name")

    echo -e "${BLUE}Skill Information: $skill_name${NC}"
    echo ""

    local source commit remote_commit version installed_at updated_at
    source=$(echo "$skill_info" | jq -r '.source')
    commit=$(echo "$skill_info" | jq -r '.commit')
    remote_commit=$(echo "$skill_info" | jq -r '.remote_commit')
    version=$(echo "$skill_info" | jq -r '.version')
    installed_at=$(echo "$skill_info" | jq -r '.installed_at')
    updated_at=$(echo "$skill_info" | jq -r '.updated_at')

    echo "Source: $source"

    if [[ -n "$version" ]] && [[ "$version" != "null" ]]; then
        echo "Version: $version"
    fi

    echo "Current Commit: $commit"
    echo "Remote Commit: $remote_commit"
    echo "Installed At: $installed_at"
    echo "Updated At: $updated_at"

    if [[ "$commit" != "$remote_commit" ]] && [[ "$remote_commit" != "unknown" ]]; then
        echo -e "${YELLOW}Update available${NC}"
    elif [[ "$commit" == "$remote_commit" ]]; then
        echo -e "${GREEN}Up to date${NC}"
    fi

    local skills_dir
    skills_dir=$(get_skills_dir)
    local skill_path="$skills_dir/$skill_name"

    if [[ -f "$skill_path/SKILL.md" ]]; then
        echo ""
        echo "Skill Metadata:"
        sed -n '/^---$/,/^---$/p' "$skill_path/SKILL.md" | sed '1d;$d'
    fi

    # Surface declared dependencies, if any.
    local reqs
    reqs=$(get_skill_requires "$skill_path")
    if [[ -n "$reqs" ]]; then
        echo ""
        echo "Requires:"
        echo "$reqs" | while IFS= read -r r; do if [[ -n "$r" ]]; then echo "  - $r"; fi; done
    fi

    if [[ -d "$skill_path/scripts" ]]; then
        echo ""
        echo "Scripts:"
        for f in "$skill_path/scripts"/*; do
            if [[ -e "$f" ]]; then echo "  - $(basename "$f")"; fi
        done
    fi

    if [[ -d "$skill_path/references" ]]; then
        echo ""
        echo "References:"
        for f in "$skill_path/references"/*; do
            if [[ -e "$f" ]]; then echo "  - $(basename "$f")"; fi
        done
    fi
}

# Remove skill
remove_skill() {
    local skill_name="$1"

    init_skills_system

    if [[ "$ALL_FLAG" == true ]]; then
        echo -e "${BLUE}Removing all skills...${NC}"

        local registry
        registry=$(read_registry)

        local skill_names
        skill_names=$(echo "$registry" | jq -r 'keys[]')

        if [[ -z "$skill_names" ]]; then
            echo "No skills installed."
            return 0
        fi

        # shellcheck disable=SC2086  # intentional word-split of newline-separated keys
        for name in $skill_names; do
            remove_single_skill "$name"
        done
    else
        if [[ -z "$skill_name" ]]; then
            echo -e "${RED}Error: remove command requires a skill name or --all flag${NC}"
            show_usage
            exit 1
        fi
        remove_single_skill "$skill_name"
    fi
}

remove_single_skill() {
    local skill_name="$1"

    echo -e "${BLUE}Removing skill: $skill_name${NC}"

    if ! is_skill_installed "$skill_name"; then
        echo -e "${YELLOW}Skill '$skill_name' is not in registry (skipping)${NC}"
        return 0
    fi

    if [[ "$YES_FLAG" != true ]]; then
        read -r -p "Are you sure you want to remove '$skill_name'? (y/N): " confirm
        if [[ "$confirm" != "y" ]] && [[ "$confirm" != "Y" ]]; then
            echo "Cancelled."
            return 0
        fi
    fi

    local skills_dir
    skills_dir=$(get_skills_dir)
    local skill_path="$skills_dir/$skill_name"

    if [[ -d "$skill_path" ]]; then
        rm -rf "$skill_path"
        echo -e "${GREEN}Removed skill directory${NC}"
    fi

    remove_skill_from_registry "$skill_name"

    echo -e "${GREEN}Skill '$skill_name' removed successfully${NC}"
}

# Verify a signed artifact (Phase 2) against the cosign trust anchor — cosign v3
# Sigstore bundle. Default bundle: <artifact>.bundle. Default key: --key, else
# $SKILLA_TRUST_KEY, else ~/.agents/cosign.pub. Requires cosign.
verify_artifact() {
    local artifact="$1"
    local bundle="${BUNDLE_FILE:-$artifact.bundle}"
    local key="${TRUST_KEY:-${SKILLA_TRUST_KEY:-$HOME/.agents/cosign.pub}}"

    if ! command -v cosign >/dev/null 2>&1; then
        echo -e "${RED}cosign is required for 'verify' but is not installed${NC}"
        echo "Install: https://docs.sigstore.dev/cosign/installation/"
        exit 1
    fi
    [[ -f "$artifact" ]] || { echo -e "${RED}artifact not found: $artifact${NC}"; exit 1; }
    [[ -f "$bundle" ]] || { echo -e "${RED}bundle not found: $bundle (pass --bundle)${NC}"; exit 1; }
    [[ -f "$key" ]] || { echo -e "${RED}trust key not found: $key (pass --key or set SKILLA_TRUST_KEY)${NC}"; exit 1; }

    echo -e "${BLUE}Verifying $artifact against $key ...${NC}"
    if cosign verify-blob --insecure-ignore-tlog=true --key "$key" --bundle "$bundle" "$artifact"; then
        echo -e "${GREEN}OK — signature is valid${NC}"
    else
        echo -e "${RED}FAILED — signature did not verify${NC}"
        exit 1
    fi
}

# =============================================================================
# Agent Plugins 1.0.0 — https://agent-plugins.org/specification
#
# A plugin is a directory with a required plugin.json manifest and components in
# fixed locations: skills/<name>/SKILL.md and mcp.json. Client-specific data
# lives under reverse-domain namespaces (manifest `extensions`, or a top-level
# com.example.client/ directory) and is ignored here by design.
#
# Failure boundaries follow the spec: unknown top-level manifest fields and a
# non-object `extensions` are reported but non-fatal; every other manifest
# violation is fatal for the whole plugin; an invalid mcp.json disables MCP only;
# an invalid single server entry or skill is skipped, and the rest still loads.
# =============================================================================

V_ERRORS=0
V_WARNINGS=0
V_MCP_ERRORS=0

_v_reset() { V_ERRORS=0; V_WARNINGS=0; V_MCP_ERRORS=0; }
_v_err()   { echo -e "  ${RED}error${NC}  $1"; V_ERRORS=$((V_ERRORS + 1)); }
_v_mcp()   { echo -e "  ${RED}error${NC}  $1"; V_MCP_ERRORS=$((V_MCP_ERRORS + 1)); }
_v_warn()  { echo -e "  ${YELLOW}warn${NC}   $1"; V_WARNINGS=$((V_WARNINGS + 1)); }
_v_note()  { echo -e "  ${GREEN}ok${NC}     $1"; }

# Manifest `name`: 1-64 chars of [a-z0-9.-], alphanumeric at both ends, and no
# `--` or `..` runs (the latter also keeps a name from escaping a path segment).
validate_plugin_name() {
    local name="$1" rc=0
    if [[ ${#name} -lt 1 || ${#name} -gt 64 ]]; then
        _v_err "plugin.json: 'name' must be 1-64 characters (got ${#name})"; rc=1
    fi
    if [[ ! "$name" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]]; then
        _v_err "plugin.json: 'name' must use [a-z0-9.-] and start/end with an alphanumeric: '$name'"; rc=1
    fi
    if [[ "$name" == *--* ]]; then
        _v_err "plugin.json: 'name' must not contain '--': '$name'"; rc=1
    fi
    if [[ "$name" == *..* ]]; then
        _v_err "plugin.json: 'name' must not contain '..': '$name'"; rc=1
    fi
    return $rc
}

# A plugin-relative path must stay inside the package: no '..' segment, no
# absolute path, no leading '~'.
_path_escapes_root() {
    local p="$1"
    [[ "$p" == /* || "$p" == "~"* ]] && return 0
    [[ "$p" == ".." || "$p" == "../"* || "$p" == */../* || "$p" == */.. ]] && return 0
    return 1
}

# Does this directory declare itself an Agent Plugin we can load?
is_agent_plugin() {
    local dir="$1"
    [[ -f "$dir/plugin.json" ]] || return 1
    local schema
    schema=$(jq -r '."$schema" // empty' "$dir/plugin.json" 2>/dev/null) || return 1
    [[ "$schema" == "$PLUGIN_SCHEMA_URL" ]]
}

# Read a manifest string field (empty when absent).
plugin_field() {
    jq -r --arg f "$2" '.[$f] // empty' "$1/plugin.json" 2>/dev/null || true
}

# Validate plugin.json. Returns non-zero on a fatal violation (plugin rejected).
validate_plugin_manifest() {
    local dir="$1" manifest="$1/plugin.json"
    local before=$V_ERRORS

    if [[ ! -f "$manifest" ]]; then
        _v_err "no plugin.json in $dir — not an Agent Plugin"
        return 1
    fi
    if ! jq -e 'type == "object"' "$manifest" >/dev/null 2>&1; then
        _v_err "plugin.json is not a JSON object (or is not valid JSON)"
        return 1
    fi

    local schema
    schema=$(jq -r '."$schema" // empty' "$manifest")
    if [[ -z "$schema" ]]; then
        _v_err "plugin.json: required field '\$schema' is missing"
    elif [[ "$schema" != "$PLUGIN_SCHEMA_URL" ]]; then
        _v_err "plugin.json: '\$schema' targets an Agent Plugins version this client does not support"
        _v_err "  found:    $schema"
        _v_err "  supported: $PLUGIN_SCHEMA_URL"
    fi

    local name
    name=$(jq -r 'if has("name") then (.name | tostring) else "" end' "$manifest")
    if ! jq -e 'has("name")' "$manifest" >/dev/null; then
        _v_err "plugin.json: required field 'name' is missing"
    elif [[ "$(jq -r '.name | type' "$manifest")" != "string" ]]; then
        _v_err "plugin.json: 'name' must be a string"
    else
        validate_plugin_name "$name" || true
    fi

    # Optional string-typed fields.
    local f t
    for f in version description homepage repository license; do
        t=$(jq -r --arg f "$f" '.[$f] | type' "$manifest")
        if [[ "$t" != "null" && "$t" != "string" ]]; then
            _v_err "plugin.json: '$f' must be a string (got $t)"
        fi
    done

    # keywords: string[]
    t=$(jq -r '.keywords | type' "$manifest")
    if [[ "$t" != "null" ]]; then
        if [[ "$t" != "array" ]]; then
            _v_err "plugin.json: 'keywords' must be an array of strings (got $t)"
        elif ! jq -e '[.keywords[] | type == "string"] | all' "$manifest" >/dev/null; then
            _v_err "plugin.json: 'keywords' must contain only strings"
        fi
    fi

    # author: object closed to {name,email,url}, all strings.
    t=$(jq -r '.author | type' "$manifest")
    if [[ "$t" != "null" ]]; then
        if [[ "$t" != "object" ]]; then
            _v_err "plugin.json: 'author' must be an object (got $t)"
        else
            local extra
            extra=$(jq -r '.author | keys_unsorted[] | select(. != "name" and . != "email" and . != "url")' "$manifest" | tr '\n' ' ')
            [[ -n "${extra// /}" ]] && _v_err "plugin.json: 'author' has fields outside {name,email,url}: ${extra% }"
            if ! jq -e '[.author[] | type == "string"] | all' "$manifest" >/dev/null; then
                _v_err "plugin.json: 'author' values must be strings"
            fi
        fi
    fi

    # extensions: a non-object value is ignored, non-fatally.
    t=$(jq -r '.extensions | type' "$manifest")
    if [[ "$t" != "null" ]]; then
        if [[ "$t" != "object" ]]; then
            _v_warn "plugin.json: 'extensions' is not an object — ignored"
        else
            if ! jq -e '[.extensions[] | type == "object"] | all' "$manifest" >/dev/null; then
                _v_err "plugin.json: every 'extensions' namespace value must be an object"
            fi
            local ns
            while IFS= read -r ns; do
                [[ -z "$ns" ]] && continue
                if [[ "$ns" != *.* ]]; then
                    _v_warn "plugin.json: extension namespace '$ns' is not reverse-domain (e.g. com.example.client)"
                fi
            done < <(jq -r '.extensions | keys_unsorted[]' "$manifest")
        fi
    fi

    # Unknown top-level fields are reported but do not stop the plugin loading.
    local unknown
    unknown=$(jq -r 'keys_unsorted[] | select(
        . != "$schema" and . != "name" and . != "version" and . != "description" and
        . != "author" and . != "homepage" and . != "repository" and . != "license" and
        . != "keywords" and . != "extensions")' "$manifest" | tr '\n' ' ')
    if [[ -n "${unknown// /}" ]]; then
        _v_warn "plugin.json: unknown top-level field(s) ignored: ${unknown% }"
        case " $unknown " in
            *" requiredSkills "*)
                _v_warn "  'requiredSkills' is not an Agent Plugins field — put it under extensions.<your.namespace>" ;;
        esac
    fi

    [[ $V_ERRORS -eq $before ]]
}

# Validate an http/https MCP endpoint URL.
_validate_mcp_url() {
    local url="$1" srv="$2"
    if [[ ! "$url" =~ ^https?:// ]]; then
        _v_mcp "mcp.json: server '$srv': 'url' must be an absolute http/https URL"
        return 1
    fi
    [[ "$url" == *"#"* ]] && _v_mcp "mcp.json: server '$srv': 'url' must not contain a fragment"

    local rest="${url#*://}" hostport
    hostport="${rest%%/*}"; hostport="${hostport%%\?*}"
    if [[ "$hostport" == *@* ]]; then
        _v_mcp "mcp.json: server '$srv': 'url' must not contain user info"
        hostport="${hostport##*@}"
    fi

    local host="${hostport%%:*}"
    if [[ "$hostport" == \[*\]* ]]; then host="${hostport%%\]*}"; fi
    host="${host#"["}"; host="${host%"]"}"

    local loopback=false
    case "$host" in
        localhost|127.*|::1|0:0:0:0:0:0:0:1) loopback=true ;;
    esac
    if [[ "$url" == http://* && "$loopback" != true ]]; then
        _v_mcp "mcp.json: server '$srv': plain http is only allowed for loopback hosts (got '$host')"
    fi
    return 0
}

# Validate a single mcpServers entry. Non-zero => skip this server, keep the rest.
_validate_mcp_server() {
    local mcp="$1" srv="$2"
    local before=$V_MCP_ERRORS
    local type
    type=$(jq -r --arg s "$srv" '.mcpServers[$s].type // empty' "$mcp")

    case "$type" in
        stdio)
            local extra
            extra=$(jq -r --arg s "$srv" '.mcpServers[$s] | keys_unsorted[] | select(
                . != "type" and . != "command" and . != "args" and . != "env" and . != "cwd")' "$mcp" | tr '\n' ' ')
            [[ -n "${extra// /}" ]] && _v_mcp "mcp.json: server '$srv': unsupported field(s) for stdio: ${extra% }"

            local command
            command=$(jq -r --arg s "$srv" '.mcpServers[$s].command // empty' "$mcp")
            if [[ -z "$command" ]]; then
                _v_mcp "mcp.json: server '$srv': stdio requires a non-empty 'command'"
            else
                # A single executable token: a bare name or a './' plugin-relative path.
                if [[ "$command" == *" "* ]]; then
                    _v_mcp "mcp.json: server '$srv': 'command' must be one executable token (move arguments into 'args')"
                fi
                # shellcheck disable=SC2016  # matching the literal placeholder text, not expanding it
                if [[ "$command" == *'${PLUGIN_ROOT}'* || "$command" == *'${PLUGIN_DATA}'* ]]; then
                    _v_mcp "mcp.json: server '$srv': placeholders are not expanded in 'command'"
                fi
                if [[ "$command" == /* ]]; then
                    _v_mcp "mcp.json: server '$srv': 'command' must be a bare name or a './' plugin-relative path"
                elif [[ "$command" == ./* ]] && _path_escapes_root "$command"; then
                    _v_mcp "mcp.json: server '$srv': 'command' escapes the plugin root"
                fi
            fi

            local t
            t=$(jq -r --arg s "$srv" '.mcpServers[$s].args | type' "$mcp")
            if [[ "$t" != "null" ]]; then
                if [[ "$t" != "array" ]]; then
                    _v_mcp "mcp.json: server '$srv': 'args' must be an array of strings"
                elif ! jq -e --arg s "$srv" '[.mcpServers[$s].args[] | type == "string"] | all' "$mcp" >/dev/null; then
                    _v_mcp "mcp.json: server '$srv': 'args' must contain only strings"
                fi
            fi

            t=$(jq -r --arg s "$srv" '.mcpServers[$s].env | type' "$mcp")
            if [[ "$t" != "null" ]]; then
                if [[ "$t" != "object" ]]; then
                    _v_mcp "mcp.json: server '$srv': 'env' must be an object"
                else
                    if ! jq -e --arg s "$srv" '[.mcpServers[$s].env[] | type == "string"] | all' "$mcp" >/dev/null; then
                        _v_mcp "mcp.json: server '$srv': 'env' values must be strings"
                    fi
                    local reserved
                    reserved=$(jq -r --arg s "$srv" '.mcpServers[$s].env | keys_unsorted[] | select(. == "PLUGIN_ROOT" or . == "PLUGIN_DATA")' "$mcp" | tr '\n' ' ')
                    [[ -n "${reserved// /}" ]] && _v_mcp "mcp.json: server '$srv': 'env' must not set reserved ${reserved% } (the client sets these)"
                fi
            fi

            local cwd
            cwd=$(jq -r --arg s "$srv" '.mcpServers[$s].cwd // empty' "$mcp")
            if [[ -n "$cwd" ]]; then
                # shellcheck disable=SC2016  # matching the literal placeholder text, not expanding it
                case "$cwd" in
                    ./*|'${PLUGIN_ROOT}'|'${PLUGIN_ROOT}/'*|'${PLUGIN_DATA}'|'${PLUGIN_DATA}/'*) ;;
                    *) _v_mcp "mcp.json: server '$srv': 'cwd' must be './…', \${PLUGIN_ROOT}[/…] or \${PLUGIN_DATA}[/…]" ;;
                esac
                if _path_escapes_root "${cwd#\$\{PLUGIN_ROOT\}/}"; then
                    _v_mcp "mcp.json: server '$srv': 'cwd' escapes its containment boundary"
                fi
            fi
            ;;
        streamable-http|sse)
            local extra
            extra=$(jq -r --arg s "$srv" '.mcpServers[$s] | keys_unsorted[] | select(
                . != "type" and . != "url" and . != "headers")' "$mcp" | tr '\n' ' ')
            [[ -n "${extra// /}" ]] && _v_mcp "mcp.json: server '$srv': unsupported field(s) for $type: ${extra% }"

            local url
            url=$(jq -r --arg s "$srv" '.mcpServers[$s].url // empty' "$mcp")
            if [[ -z "$url" ]]; then
                _v_mcp "mcp.json: server '$srv': $type requires a 'url'"
            else
                _validate_mcp_url "$url" "$srv" || true
            fi

            local t
            t=$(jq -r --arg s "$srv" '.mcpServers[$s].headers | type' "$mcp")
            if [[ "$t" != "null" ]]; then
                if [[ "$t" != "object" ]]; then
                    _v_mcp "mcp.json: server '$srv': 'headers' must be an object"
                else
                    if ! jq -e --arg s "$srv" '[.mcpServers[$s].headers[] | type == "string"] | all' "$mcp" >/dev/null; then
                        _v_mcp "mcp.json: server '$srv': 'headers' values must be strings"
                    fi
                    # Header names are case-insensitive: duplicates are not allowed.
                    local dupes
                    dupes=$(jq -r --arg s "$srv" '.mcpServers[$s].headers | keys_unsorted | map(ascii_downcase) | group_by(.) | map(select(length > 1) | .[0]) | .[]' "$mcp" | tr '\n' ' ')
                    [[ -n "${dupes// /}" ]] && _v_mcp "mcp.json: server '$srv': duplicate header name(s) ignoring case: ${dupes% }"
                fi
            fi
            if [[ "$type" == "sse" ]]; then
                _v_warn "mcp.json: server '$srv' uses the deprecated HTTP+SSE transport (MCP 2024-11-05)"
            fi
            ;;
        "")
            _v_mcp "mcp.json: server '$srv': missing 'type'"
            ;;
        *)
            _v_mcp "mcp.json: server '$srv': unsupported transport '$type' — server skipped"
            ;;
    esac

    [[ $V_MCP_ERRORS -eq $before ]]
}

# Validate mcp.json. Returns non-zero when MCP must be disabled for the plugin
# (missing mcp.json is a valid absence and returns 0).
validate_mcp_config() {
    local dir="$1" mcp="$1/mcp.json"
    [[ -f "$mcp" ]] || return 0
    local before=$V_MCP_ERRORS

    if ! jq -e 'type == "object"' "$mcp" >/dev/null 2>&1; then
        _v_mcp "mcp.json is not a JSON object (or is not valid JSON) — MCP disabled"
        return 1
    fi

    # plugin.json and mcp.json must target the same Agent Plugins version, and
    # that version must be the one this client supports.
    local schema
    schema=$(jq -r '."$schema" // empty' "$mcp")
    if [[ "$schema" != "$MCP_SCHEMA_URL" ]]; then
        _v_mcp "mcp.json: '\$schema' must be $MCP_SCHEMA_URL (found: ${schema:-<missing>}) — MCP disabled"
    fi

    if ! jq -e 'has("mcpServers")' "$mcp" >/dev/null; then
        _v_mcp "mcp.json: required field 'mcpServers' is missing — MCP disabled"
    elif [[ "$(jq -r '.mcpServers | type' "$mcp")" != "object" ]]; then
        _v_mcp "mcp.json: 'mcpServers' must be an object — MCP disabled"
    fi

    local extra
    extra=$(jq -r 'keys_unsorted[] | select(. != "$schema" and . != "mcpServers")' "$mcp" | tr '\n' ' ')
    [[ -n "${extra// /}" ]] && _v_mcp "mcp.json: unsupported top-level field(s): ${extra% } — MCP disabled"

    if [[ $V_MCP_ERRORS -ne $before ]]; then
        return 1
    fi

    local srv
    while IFS= read -r srv; do
        [[ -z "$srv" ]] && continue
        _validate_mcp_server "$mcp" "$srv" || true
    done < <(jq -r '.mcpServers | keys_unsorted[]' "$mcp")

    return 0
}

# Validate the skills/ component against agentskills.io. A non-conformant skill
# is skipped; the rest of the plugin still loads.
validate_plugin_skills() {
    local dir="$1"
    [[ -d "$dir/skills" ]] || return 0     # a missing component location is valid absence

    local d base name desc
    for d in "$dir"/skills/*/; do
        [[ -d "$d" ]] || continue
        base=$(basename "$d")
        if [[ ! -f "${d}SKILL.md" ]]; then
            _v_warn "skills/$base: no SKILL.md — not a skill, skipped"
            continue
        fi
        name=$(extract_frontmatter_field "$d" "name")
        desc=$(extract_frontmatter_field "$d" "description")
        if [[ -z "$name" ]]; then
            _v_warn "skills/$base: SKILL.md frontmatter has no 'name' — skill skipped"
        else
            [[ "$name" != "$base" ]] && _v_warn "skills/$base: frontmatter name '$name' must match the directory name"
            if [[ ! "$name" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || [[ "$name" == *--* ]] || [[ ${#name} -gt 64 ]]; then
                _v_warn "skills/$base: 'name' must be 1-64 chars of [a-z0-9-], no leading/trailing/double hyphen"
            fi
        fi
        if [[ -z "$desc" ]]; then
            _v_warn "skills/$base: SKILL.md frontmatter has no 'description' — skill skipped"
        elif [[ ${#desc} -gt 1024 ]]; then
            _v_warn "skills/$base: 'description' exceeds 1024 characters (${#desc})"
        fi
    done
    return 0
}

# Count / list the skills a plugin provides.
plugin_skill_names() {
    local dir="$1" d
    [[ -d "$dir/skills" ]] || return 0
    for d in "$dir"/skills/*/; do
        [[ -f "${d}SKILL.md" ]] && basename "$d"
    done
}

# Expand ${PLUGIN_ROOT}/${PLUGIN_DATA} in a single non-recursive pass. Only ever
# applied to args elements, env values and cwd — never to env keys or command.
expand_plugin_placeholders() {
    local s="$1" root="$2" data="$3"
    s="${s//\$\{PLUGIN_ROOT\}/$root}"
    s="${s//\$\{PLUGIN_DATA\}/$data}"
    printf '%s' "$s"
}

# --- plugin subcommands ------------------------------------------------------

# Print the manifest header shared by `plugin ls` and `plugin info`.
_print_plugin_manifest() {
    local dir="$1"
    local name version desc license homepage repo author keywords
    name=$(plugin_field "$dir" name)
    version=$(plugin_field "$dir" version)
    desc=$(plugin_field "$dir" description)
    license=$(plugin_field "$dir" license)
    homepage=$(plugin_field "$dir" homepage)
    repo=$(plugin_field "$dir" repository)
    author=$(jq -r '.author | if . == null then "" else [.name, .email, .url] | map(select(. != null)) | join(" · ") end' "$dir/plugin.json" 2>/dev/null || true)
    keywords=$(jq -r '.keywords // [] | join(", ")' "$dir/plugin.json" 2>/dev/null || true)

    echo "Name:        $name"
    [[ -n "$version"  ]] && echo "Version:     $version"
    [[ -n "$desc"     ]] && echo "Description: $desc"
    [[ -n "$author"   ]] && echo "Author:      $author"
    [[ -n "$license"  ]] && echo "License:     $license"
    [[ -n "$homepage" ]] && echo "Homepage:    $homepage"
    [[ -n "$repo"     ]] && echo "Repository:  $repo"
    [[ -n "$keywords" ]] && echo "Keywords:    $keywords"
    echo "Spec:        Agent Plugins $AGENT_PLUGINS_VERSION"
    return 0
}

# Print the component inventory (skills, MCP servers, extension namespaces).
_print_plugin_components() {
    local dir="$1"

    local names
    names=$(plugin_skill_names "$dir")
    echo ""
    if [[ -n "$names" ]]; then
        echo "Skills (skills/):"
        local s ver desc
        while IFS= read -r s; do
            [[ -z "$s" ]] && continue
            ver=$(extract_skill_version "$dir/skills/$s"); [[ -z "$ver" ]] && ver="-"
            desc=$(extract_frontmatter_field "$dir/skills/$s" "description")
            [[ ${#desc} -gt 60 ]] && desc="${desc:0:57}..."
            printf "  %-24s %-10s %s\n" "$s" "$ver" "$desc"
        done <<< "$names"
    else
        echo "Skills (skills/): none"
    fi

    echo ""
    if [[ -f "$dir/mcp.json" ]]; then
        echo "MCP servers (mcp.json):"
        local srv type target
        while IFS= read -r srv; do
            [[ -z "$srv" ]] && continue
            type=$(jq -r --arg s "$srv" '.mcpServers[$s].type // "?"' "$dir/mcp.json")
            if [[ "$type" == "stdio" ]]; then
                target=$(jq -r --arg s "$srv" '[.mcpServers[$s].command] + (.mcpServers[$s].args // []) | join(" ")' "$dir/mcp.json")
            else
                target=$(jq -r --arg s "$srv" '.mcpServers[$s].url // ""' "$dir/mcp.json")
            fi
            printf "  %-24s %-16s %s\n" "$srv" "$type" "$target"
        done < <(jq -r '.mcpServers // {} | keys_unsorted[]' "$dir/mcp.json" 2>/dev/null)
        echo ""
        echo "  skilla does not run MCP servers — 'skilla plugin mcp <name>' prints this"
        echo "  config with \${PLUGIN_ROOT}/\${PLUGIN_DATA} expanded, for your host's config."
    else
        echo "MCP servers (mcp.json): none"
    fi

    local ns
    ns=$(jq -r '.extensions // {} | keys_unsorted | join(", ")' "$dir/plugin.json" 2>/dev/null || true)
    local extdirs=() d
    for d in "$dir"/*/; do
        [[ -d "$d" ]] || continue
        local b; b=$(basename "$d")
        [[ "$b" == "skills" ]] && continue
        [[ "$b" == *.* ]] && extdirs+=("$b")
    done
    if [[ -n "$ns" || ${#extdirs[@]} -gt 0 ]]; then
        echo ""
        echo "Client extensions (ignored by skilla):"
        [[ -n "$ns" ]] && echo "  manifest namespaces: $ns"
        [[ ${#extdirs[@]} -gt 0 ]] && echo "  directories:         ${extdirs[*]}"
    fi
    return 0
}

# Validate a plugin directory against Agent Plugins 1.0.0.
cmd_plugin_validate() {
    local dir="${1:-.}"
    if [[ ! -d "$dir" ]]; then
        echo -e "${RED}Not a directory: $dir${NC}"
        return 1
    fi

    echo -e "${BLUE}Validating $dir against Agent Plugins $AGENT_PLUGINS_VERSION${NC}"
    echo ""
    _v_reset

    local manifest_ok=true
    validate_plugin_manifest "$dir" || manifest_ok=false

    if [[ "$manifest_ok" == true ]]; then
        _v_note "plugin.json conforms"
    else
        echo ""
        echo -e "  ${YELLOW}a client would reject the plugin here, before discovering components;${NC}"
        echo -e "  ${YELLOW}checking the rest anyway so you can fix everything in one pass${NC}"
        echo ""
    fi

    validate_plugin_skills "$dir"
    local mcp_ok=true
    validate_mcp_config "$dir" || mcp_ok=false
    if [[ -f "$dir/mcp.json" ]]; then
        if [[ "$mcp_ok" == true && $V_MCP_ERRORS -eq 0 ]]; then
            _v_note "mcp.json conforms"
        else
            _v_warn "mcp.json is invalid — a conformant client disables MCP and loads the rest"
        fi
    fi

    echo ""
    if [[ "$manifest_ok" != true ]]; then
        echo -e "${RED}FAILED — the manifest is fatally invalid, so the whole plugin is rejected${NC}"
        echo "$V_ERRORS error(s), $((V_MCP_ERRORS)) MCP error(s), $V_WARNINGS warning(s)"
        return 1
    fi
    if [[ $V_ERRORS -gt 0 || $V_MCP_ERRORS -gt 0 ]]; then
        echo -e "${YELLOW}$V_ERRORS error(s), $V_MCP_ERRORS MCP error(s), $V_WARNINGS warning(s)${NC}"
        return 1
    fi
    echo -e "${GREEN}OK — conformant Agent Plugin ($V_WARNINGS warning(s))${NC}"
    return 0
}

# Inspect a plugin at a git source without installing anything.
cmd_plugin_ls() {
    local source="$1"
    if [[ -z "$source" ]]; then
        echo -e "${RED}Error: plugin ls requires a source URL${NC}"
        return 1
    fi

    local temp_dir
    temp_dir=$(mktemp -d)
    echo -e "${BLUE}Inspecting plugin: $source${NC}"
    if ! clone_source "$source" "$temp_dir" "plugin.json" \
            "/plugin.json" "/mcp.json" "/skills/*/SKILL.md"; then
        echo -e "${RED}Failed to clone repository${NC}"
        rm -rf "$temp_dir"
        return 1
    fi

    if [[ ! -f "$temp_dir/plugin.json" ]]; then
        echo -e "${RED}No plugin.json at the source root — not an Agent Plugin${NC}"
        echo "Use 'skilla repo ls $source' to browse it as a plain skills repository."
        rm -rf "$temp_dir"
        return 1
    fi

    echo ""
    _print_plugin_manifest "$temp_dir"
    _print_plugin_components "$temp_dir"
    echo ""
    echo "Install with: skilla plugin add $source"
    rm -rf "$temp_dir"
}

# Registry of installed plugins (separate file so skill names can never collide
# with plugin names).
read_plugin_registry() {
    local f; f=$(get_plugin_registry_file)
    if [[ -f "$f" ]]; then cat "$f"; else echo '{}'; fi
}

save_plugin_info() {
    local name="$1" info="$2" reg
    reg=$(read_plugin_registry)
    echo "$reg" | jq --arg n "$name" --argjson i "$info" '.[$n] = $i' > "$(get_plugin_registry_file)"
}

remove_plugin_from_registry() {
    local name="$1" reg
    reg=$(read_plugin_registry)
    echo "$reg" | jq --arg n "$name" 'del(.[$n])' > "$(get_plugin_registry_file)"
}

get_plugin_info() {
    read_plugin_registry | jq -r --arg n "$1" '.[$n] // empty'
}

# Resolve an installed plugin's PLUGIN_ROOT / PLUGIN_DATA into the two globals
# below. The current scope's layout wins (a project can be cloned to another
# path); the values recorded at install time are the fallback.
PLUGIN_ROOT_PATH=""
PLUGIN_DATA_PATH=""
resolve_plugin_paths() {
    local name="$1" info="$2" stored
    PLUGIN_ROOT_PATH=$(plugin_root_for "$name")
    PLUGIN_DATA_PATH=$(plugin_data_for "$name")
    if [[ ! -d "$PLUGIN_ROOT_PATH" ]]; then
        stored=$(echo "$info" | jq -r '.root // empty')
        [[ -n "$stored" && -d "$stored" ]] && PLUGIN_ROOT_PATH="$stored"
        stored=$(echo "$info" | jq -r '.data // empty')
        [[ -n "$stored" ]] && PLUGIN_DATA_PATH="$stored"
    fi
    return 0
}

# Install an Agent Plugin: the package tree is kept intact under plugins/<name>/
# (so ${PLUGIN_ROOT} resolves), its skills are also copied into the skills dir
# where agents actually index them, and a persistent PLUGIN_DATA dir is created.
cmd_plugin_add() {
    local source="$1"
    if [[ -z "$source" ]]; then
        echo -e "${RED}Error: plugin add requires a source URL${NC}"
        return 1
    fi

    init_skills_system
    echo -e "${BLUE}Adding plugin from: $source${NC}"

    local temp_dir
    temp_dir=$(mktemp -d)
    echo "Cloning repository..."
    if ! clone_source "$source" "$temp_dir"; then
        echo -e "${RED}Failed to clone repository${NC}"
        rm -rf "$temp_dir"
        return 1
    fi

    if [[ ! -f "$temp_dir/plugin.json" ]]; then
        echo -e "${RED}No plugin.json at the source root — not an Agent Plugin${NC}"
        echo "Install it as a plain skills repository with: skilla add $source"
        rm -rf "$temp_dir"
        return 1
    fi

    echo ""
    _v_reset
    if ! validate_plugin_manifest "$temp_dir"; then
        echo ""
        echo -e "${RED}Plugin rejected: plugin.json is fatally invalid${NC}"
        rm -rf "$temp_dir"
        return 1
    fi
    validate_plugin_skills "$temp_dir"
    local mcp_enabled=true
    validate_mcp_config "$temp_dir" || mcp_enabled=false
    [[ $V_MCP_ERRORS -gt 0 ]] && mcp_enabled=false

    local name
    name=$(plugin_field "$temp_dir" name)
    local version; version=$(plugin_field "$temp_dir" version)

    if [[ "$CHECK_ONLY" == true ]]; then
        echo ""
        if [[ -n "$(get_plugin_info "$name")" ]]; then
            echo -e "${YELLOW}'$name' is already installed (would reinstall with --force)${NC}"
        else
            echo -e "${GREEN}'$name' not installed (would install)${NC}"
        fi
        rm -rf "$temp_dir"
        return 0
    fi

    if [[ -n "$(get_plugin_info "$name")" && "$FORCE_FLAG" != true ]]; then
        echo -e "${YELLOW}Plugin '$name' is already installed — use 'plugin add --force' to reinstall${NC}"
        rm -rf "$temp_dir"
        return 0
    fi

    local plugins_dir root data
    plugins_dir=$(get_plugins_dir)
    mkdir -p "$plugins_dir" "$(get_agents_dir)/plugin-data/$name"
    # PLUGIN_DATA must persist across updates — created above, never wiped here.
    root=$(plugin_root_for "$name")
    data=$(plugin_data_for "$name")

    rm -rf "$root"
    cp -r "$temp_dir" "$root"
    rm -rf "$root/.git"

    # Surface the plugin's skills where agents index them.
    local skills_dir installed=() s
    skills_dir=$(get_skills_dir)
    while IFS= read -r s; do
        [[ -z "$s" ]] && continue
        # Skip skills the validator rejected outright (no name/description).
        if [[ -z "$(extract_frontmatter_field "$root/skills/$s" "name")" ]] || \
           [[ -z "$(extract_frontmatter_field "$root/skills/$s" "description")" ]]; then
            echo -e "${YELLOW}  skipping non-conformant skill: $s${NC}"
            continue
        fi
        rm -rf "${skills_dir:?}/$s"
        cp -r "$root/skills/$s" "$skills_dir/$s"
        installed+=("$s")

        local sver sinfo
        sver=$(extract_skill_version "$skills_dir/$s")
        sinfo=$(jq -n --arg name "$s" --arg source "$source" \
            --arg commit "$(get_git_commit "$temp_dir")" \
            --arg remote_commit "$(get_remote_commit "$source")" \
            --arg version "$sver" --arg plugin "$name" --arg installed_at "$(_now)" \
            '{name:$name, source:$source, commit:$commit, remote_commit:$remote_commit,
              version:$version, plugin:$plugin, installed_at:$installed_at, updated_at:$installed_at}')
        save_skill_info "$s" "$sinfo"
    done < <(plugin_skill_names "$root")

    local info
    info=$(jq -n --arg name "$name" --arg source "$source" --arg version "$version" \
        --arg spec "$AGENT_PLUGINS_VERSION" --arg commit "$(get_git_commit "$temp_dir")" \
        --arg root "$root" --arg data "$data" --arg mcp "$mcp_enabled" \
        --arg installed_at "$(_now)" --argjson skills "$(printf '%s\n' "${installed[@]:-}" | jq -R . | jq -s 'map(select(. != ""))')" \
        '{name:$name, source:$source, version:$version, spec:$spec, commit:$commit,
          root:$root, data:$data, mcp_enabled:($mcp == "true"), skills:$skills,
          installed_at:$installed_at, updated_at:$installed_at}')
    save_plugin_info "$name" "$info"

    echo ""
    echo -e "${GREEN}installed plugin '$name' (${version:-unversioned})${NC}"
    echo "  PLUGIN_ROOT: $root"
    echo "  PLUGIN_DATA: $data"
    if [[ ${#installed[@]} -gt 0 ]]; then
        echo "  skills:      ${installed[*]} -> $skills_dir"
    else
        echo "  skills:      none"
    fi
    if [[ -f "$root/mcp.json" ]]; then
        if [[ "$mcp_enabled" == true ]]; then
            echo "  mcp:         $(jq -r '.mcpServers // {} | keys_unsorted | join(", ")' "$root/mcp.json") — 'skilla plugin mcp $name' to wire it into your host"
        else
            echo -e "  mcp:         ${YELLOW}disabled (mcp.json is invalid)${NC}"
        fi
    fi

    rm -rf "$temp_dir"
}

cmd_plugin_list() {
    init_skills_system
    local scope_text="project"
    if [[ -n "$CUSTOM_PATH" ]]; then scope_text="custom path"
    elif [[ "$GLOBAL_FLAG" == true ]]; then scope_text="user"; fi

    echo -e "${BLUE}Installed plugins ($scope_text):${NC}"
    echo ""
    local reg count
    reg=$(read_plugin_registry)
    count=$(echo "$reg" | jq 'length')
    if [[ "$count" -eq 0 ]]; then
        echo "No plugins installed."
        return 0
    fi

    printf "%-26s %-12s %-8s %-6s %s\n" "NAME" "VERSION" "SKILLS" "MCP" "SOURCE"
    printf "%-26s %-12s %-8s %-6s %s\n" "----" "-------" "------" "---" "------"
    echo "$reg" | jq -r 'to_entries[] | [.key, (.value.version // "-"), (.value.skills | length | tostring), (if .value.mcp_enabled then "yes" else "-" end), .value.source] | @tsv' \
        | while IFS=$'\t' read -r n v sc mcp src; do
            [[ ${#src} -gt 40 ]] && src="${src:0:37}..."
            printf "%-26s %-12s %-8s %-6s %s\n" "$n" "${v:--}" "$sc" "$mcp" "$src"
        done
}

cmd_plugin_info() {
    local name="$1"
    init_skills_system
    local info; info=$(get_plugin_info "$name")
    if [[ -z "$info" ]]; then
        echo -e "${RED}Plugin '$name' is not installed${NC}"
        return 1
    fi
    local root data
    resolve_plugin_paths "$name" "$info"
    root="$PLUGIN_ROOT_PATH"
    data="$PLUGIN_DATA_PATH"

    echo -e "${BLUE}Plugin: $name${NC}"
    echo ""
    if [[ -f "$root/plugin.json" ]]; then
        _print_plugin_manifest "$root"
    fi
    echo "Source:      $(echo "$info" | jq -r '.source')"
    echo "Commit:      $(echo "$info" | jq -r '.commit')"
    echo "Installed:   $(echo "$info" | jq -r '.installed_at')"
    echo "PLUGIN_ROOT: $root"
    echo "PLUGIN_DATA: $data"
    [[ -f "$root/plugin.json" ]] && _print_plugin_components "$root"
    return 0
}

# Print the plugin's mcp.json with the two placeholders expanded, ready to paste
# into a host's MCP configuration.
cmd_plugin_mcp() {
    local name="$1"
    init_skills_system
    local info; info=$(get_plugin_info "$name")
    if [[ -z "$info" ]]; then
        echo -e "${RED}Plugin '$name' is not installed${NC}" >&2
        return 1
    fi
    local root data
    resolve_plugin_paths "$name" "$info"
    root="$PLUGIN_ROOT_PATH"
    data="$PLUGIN_DATA_PATH"
    if [[ ! -f "$root/mcp.json" ]]; then
        echo -e "${YELLOW}Plugin '$name' declares no MCP servers${NC}" >&2
        return 0
    fi
    if [[ "$(echo "$info" | jq -r '.mcp_enabled')" != "true" ]]; then
        echo -e "${YELLOW}Warning: this plugin's mcp.json failed validation — MCP is disabled${NC}" >&2
    fi
    # Expansion applies to args elements, env values and cwd only — never to env
    # keys or to command. PLUGIN_ROOT/PLUGIN_DATA are then set by the client.
    jq --arg root "$root" --arg data "$data" '
        def expand: gsub("\\$\\{PLUGIN_ROOT\\}"; $root) | gsub("\\$\\{PLUGIN_DATA\\}"; $data);
        .mcpServers |= with_entries(.value |= (
              (if has("args") then .args |= map(expand) else . end)
            | (if has("env")  then .env  |= with_entries(.value |= expand) else . end)
            | (if has("cwd")  then .cwd  |= expand else . end)
            | (if .type == "stdio" then .env = ((.env // {}) + {PLUGIN_ROOT: $root, PLUGIN_DATA: $data}) else . end)
        ))' "$root/mcp.json"
}

cmd_plugin_remove() {
    local name="$1"
    init_skills_system
    local info; info=$(get_plugin_info "$name")
    if [[ -z "$info" ]]; then
        echo -e "${YELLOW}Plugin '$name' is not in the registry (skipping)${NC}"
        return 0
    fi

    if [[ "$YES_FLAG" != true ]]; then
        read -r -p "Remove plugin '$name', its skills and its plugin data? (y/N): " confirm
        if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
            echo "Cancelled."
            return 0
        fi
    fi

    local root data skills_dir s
    resolve_plugin_paths "$name" "$info"
    root="$PLUGIN_ROOT_PATH"
    data="$PLUGIN_DATA_PATH"
    skills_dir=$(get_skills_dir)

    while IFS= read -r s; do
        [[ -z "$s" ]] && continue
        # Only remove a skill still attributed to this plugin.
        if [[ "$(get_skill_info "$s" | jq -r '.plugin // empty')" == "$name" ]]; then
            rm -rf "${skills_dir:?}/$s"
            remove_skill_from_registry "$s"
            echo "  removed skill: $s"
        fi
    done < <(echo "$info" | jq -r '.skills[]?')

    [[ -n "$root" && -d "$root" ]] && rm -rf "$root"
    [[ -n "$data" && -d "$data" ]] && rm -rf "$data"
    remove_plugin_from_registry "$name"
    echo -e "${GREEN}Plugin '$name' removed${NC}"
    return 0
}

# Derive a manifest-legal name from a directory name: lowercase, [a-z0-9.-] only,
# no '--' or '..' runs, alphanumeric at both ends, 64 chars max. A directory like
# 'my__tools' would otherwise yield 'my--tools', which the spec forbids.
_derive_plugin_name() {
    local n
    n=$(basename "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9.-' '-' | tr -s '.-' '.-')
    n="${n#"${n%%[a-z0-9]*}"}"          # strip leading non-alphanumerics
    n="${n%"${n##*[a-z0-9]}"}"          # strip trailing non-alphanumerics
    n="${n:0:64}"
    n="${n%"${n##*[a-z0-9]}"}"          # truncation may leave a trailing '.' or '-'
    if [[ -z "$n" ]]; then echo "my-plugin"; else echo "$n"; fi
}

# Scaffold a conformant plugin skeleton.
cmd_plugin_init() {
    local dir="${1:-.}"
    mkdir -p "$dir/skills"
    local name
    name=$(_derive_plugin_name "$(cd "$dir" && pwd -P)")

    if [[ -f "$dir/plugin.json" ]]; then
        echo -e "${YELLOW}$dir/plugin.json already exists — leaving it alone${NC}"
    else
        jq -n --arg schema "$PLUGIN_SCHEMA_URL" --arg name "$name" '{
            "$schema": $schema,
            name: $name,
            version: "0.1.0",
            description: "What this plugin provides and when to use it.",
            license: "MIT"
        }' > "$dir/plugin.json"
        echo -e "${GREEN}created${NC} $dir/plugin.json (Agent Plugins $AGENT_PLUGINS_VERSION, name: $name)"
    fi

    echo -e "${GREEN}ready${NC}   $dir/skills/ — add skills/<name>/SKILL.md (agentskills.io)"
    echo ""
    echo "Optional: an mcp.json alongside plugin.json, e.g."
    echo "  {\"\$schema\": \"$MCP_SCHEMA_URL\", \"mcpServers\": {}}"
    echo ""
    echo "Then check it with: skilla plugin validate $dir"
}

cmd_plugin() {
    local sub="${1:-}"
    shift || true
    case "$sub" in
        ls|list)
            # `plugin ls <source>` inspects a remote source; bare `plugin ls`
            # lists what is installed.
            if [[ -n "${1:-}" ]]; then cmd_plugin_ls "$1"; else cmd_plugin_list; fi ;;
        add|install) cmd_plugin_add "${1:-}" ;;
        info)
            if [[ -z "${1:-}" ]]; then echo -e "${RED}Error: plugin info requires a name${NC}"; return 1; fi
            cmd_plugin_info "$1" ;;
        mcp)
            if [[ -z "${1:-}" ]]; then echo -e "${RED}Error: plugin mcp requires a name${NC}"; return 1; fi
            cmd_plugin_mcp "$1" ;;
        remove|rm)
            if [[ -z "${1:-}" ]]; then echo -e "${RED}Error: plugin remove requires a name${NC}"; return 1; fi
            cmd_plugin_remove "$1" ;;
        validate|check) cmd_plugin_validate "${1:-.}" ;;
        init)           cmd_plugin_init "${1:-.}" ;;
        *)
            echo -e "${RED}Unknown plugin subcommand: ${sub:-<none>}${NC}"
            echo "Try: plugin ls|add|info|mcp|remove|validate|init"
            return 1 ;;
    esac
}

# Show usage
show_usage() {
    local self="${BASH_SOURCE[0]}"
    local loc
    loc="$(cd "$(dirname "$self")" 2>/dev/null && pwd -P)/$(basename "$self")"
    cat << EOF
skilla - Manage Agent Skills and Agent Plugins from git repositories
Skills:  https://agentskills.io/specification
Plugins: https://agent-plugins.org/specification (Agent Plugins $AGENT_PLUGINS_VERSION)

Usage: skilla <command> [options] [arguments]

Global Options:
    --scope <user|project>  Where skills live: 'project' = ./.agents/skills/ (default),
                            'user' = ~/.agents/skills/
    -g, --global          Shorthand for --scope user
    --path <folder>       Use custom skills directory
    -y, --yes             Auto-confirm prompts (e.g., for remove)
    --check               Only check for updates, don't apply them
    --all                 Apply to all skills (for remove)
    --force               Reinstall skills even if already installed (for add)
    -s, --skill <name>    Install only a specific skill from the repository
    --bundle <file>       Sigstore bundle for 'verify' (default: <artifact>.bundle)
    --key <file>          Public key for 'verify' (default: \$SKILLA_TRUST_KEY or ~/.agents/cosign.pub)

Skill commands:
    add <source>          Add (install) skills from a git URL (with --force to reinstall)
    repo ls <source>      List the skills available in a repository (no install)
    update [skill]        Update a specific skill or all skills
    list, ls              List all installed skills with their versions
    info <skill>          Show detailed information about a skill
    remove, rm [skill]    Remove a skill (or all skills with --all)

Plugin commands (Agent Plugins $AGENT_PLUGINS_VERSION):
    plugin ls [source]    Inspect a plugin at a git URL, or list installed plugins
    plugin add <source>   Install a plugin: package + its skills + its plugin data
    plugin info <name>    Manifest, components, PLUGIN_ROOT / PLUGIN_DATA
    plugin mcp <name>     Print the plugin's mcp.json with placeholders expanded
    plugin remove <name>  Uninstall a plugin, its skills and its plugin data
    plugin validate [dir] Conformance-check a plugin directory (default: .)
    plugin init [dir]     Scaffold a conformant plugin.json + skills/

Other:
    verify <artifact>     Verify a signed release artifact (cosign) against the trust key
    version               Print the skilla version (also -v, --version)

Examples:
    skilla repo ls https://github.com/microsoft/azure-skills
    skilla add <repository-url>
    skilla add --scope user <repository-url>
    skilla add --skill nginx-validation <repository-url>
    skilla update nginx-validation
    skilla list
    skilla info nginx-validation
    skilla rm --all -y

    skilla plugin ls https://github.com/acme/my-plugin       # inspect, no install
    skilla plugin add https://github.com/acme/my-plugin
    skilla plugin mcp my-plugin >> ~/.config/host/mcp.json   # wire MCP into your host
    skilla plugin validate .                                 # authoring a plugin
    skilla plugin init ./my-plugin

Notes:
    - --scope project (the default) installs to the project's .agents/skills/ (the
      path Devin indexes for that repo); --scope user (or -g) installs to the
      user-global ~/.agents/skills/ (Devin Desktop). Plugins live beside them in
      .agents/plugins/<name>/ with persistent data in .agents/plugin-data/<name>/.
    - Version is read from SKILL.md 'metadata.version' (the agentskills.io
      location), then a legacy top-level 'version:', then plugin.json, then the
      commit hash.
    - Dependencies declared via 'metadata.requires' or 'requires:' in SKILL.md (or
      plugin.json 'requiredSkills') are installed automatically from the same source.
    - add --skill, update, and repo ls fetch only the needed files (partial +
      sparse clone) when the server supports it — full shallow clone otherwise.
    - skilla never runs MCP servers or skill code. 'plugin mcp' prints a ready
      config; your host launches it.
    - Only removes skills that are in the registry; ignores other files in the
      skills directory.

Location: $loc
